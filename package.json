{
  "name": "trainerroad-cli",
  "version": "0.5.0",
  "description": "Unofficial CLI for authenticating with TrainerRoad and querying timeline/workout data",
  "main": "dist/bin.cjs",
  "bin": {
    "trainerroad-cli": "bin/trainerroad-cli.mjs",
    "trcli": "bin/trainerroad-cli.mjs"
  },
  "files": [
    "bin",
    "dist",
    "guides",
    "skills",
    "LASSO-LICENSE",
    "CHANGELOG.md",
    "README.md",
    "MIGRATION.md",
    "docs/workflow-coverage.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "node src/bin.ts",
    "cli": "node src/bin.ts",
    "build": "tsdown",
    "prepare": "effect-tsgo patch --oxlint",
    "fmt": "biome format --write .",
    "lint": "oxlint --type-aware --deny-warnings",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "vitest run && node --test tests/*.test.mjs",
    "check": "biome format . && npm run lint && npm run typecheck && node scripts/guides.mjs --check && npm test",
    "check:push": "npm run check && node scripts/pack-smoke.mjs"
  },
  "keywords": [
    "trainerroad",
    "cli",
    "unofficial"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=22.19"
  },
  "type": "module",
  "optionalDependencies": {
    "@resvg/resvg-js": "^2.6.2"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.0-beta.106"
  },
  "devDependencies": {
    "playwright": "^1.58.2",
    "@biomejs/biome": "2.5.7",
    "@effect/platform-node": "4.0.0-beta.106",
    "@effect/tsgo": "0.36.1",
    "@types/node": "22.20.1",
    "effect": "4.0.0-beta.106",
    "execa": "10.0.1",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "7.0.2001",
    "tsdown": "0.22.14",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
